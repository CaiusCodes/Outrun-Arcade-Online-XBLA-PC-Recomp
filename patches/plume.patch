diff --git a/plume_d3d12.cpp b/plume_d3d12.cpp
index dcae4e3..8e04e04 100644
--- a/plume_d3d12.cpp
+++ b/plume_d3d12.cpp
@@ -250,6 +250,10 @@ namespace plume {
         if (dxgiFormat == DXGI_FORMAT_R24G8_TYPELESS) {
             return DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
         }
+        if (dxgiFormat == DXGI_FORMAT_R32_TYPELESS) {
+            // Depth target that is also sampled (created typeless).
+            return DXGI_FORMAT_R32_FLOAT;
+        }
         return dxgiFormat;
     }
 
@@ -262,6 +266,9 @@ namespace plume {
         if (dxgiFormat == DXGI_FORMAT_R24G8_TYPELESS) {
             return DXGI_FORMAT_D24_UNORM_S8_UINT;
         }
+        if (dxgiFormat == DXGI_FORMAT_R32_TYPELESS) {
+            return DXGI_FORMAT_D32_FLOAT;
+        }
         return dxgiFormat;
     }
 
diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
