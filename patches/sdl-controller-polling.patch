-SDLInputDriver::~SDLInputDriver() {}
+SDLInputDriver::~SDLInputDriver() {
+  // Also stop on teardown paths that never receive a window-close event.
+  StopJoystickUpdates();
+}
+
+void SDLInputDriver::StartJoystickUpdates() {
+      joystick_thread_ = std::jthread([](std::stop_token stop) {
+        while (!stop.stop_requested()) {
+          { PollTimer timing("SDL_UpdateJoysticks worker"); SDL_UpdateJoysticks(); }
+          std::this_thread::sleep_for(std::chrono::milliseconds(4));
+        }
+      });
+}
+
+void SDLInputDriver::StopJoystickUpdates() {
+  if (joystick_thread_.joinable()) {
+    joystick_thread_.request_stop();
+    joystick_thread_.join();
+  }
+  // Do not leave a callback with a dangling driver pointer in SDL's watch list.
+  if (event_watch_registered_) {
+    SDL_RemoveEventWatch(&SDLInputDriver::WatchEvent, this);
+    event_watch_registered_ = false;
+  }
+}
+
+bool SDLCALL SDLInputDriver::WatchEvent(void* userdata, SDL_Event* event) {
+  if (!userdata || !event) return false;
+  if (event->type >= SDL_EVENT_JOYSTICK_AXIS_MOTION && event->type < SDL_EVENT_FINGER_DOWN)
+    static_cast<SDLInputDriver*>(userdata)->HandleEvent(*event);
+  return false;
+}
 
