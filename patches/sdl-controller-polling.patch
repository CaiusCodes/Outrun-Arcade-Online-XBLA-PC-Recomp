+
 namespace rex::input::sdl {
+namespace {
+std::atomic<int> g_connected_gamepads{0};
+class PollTimer {
+ public:
+  explicit PollTimer(const char* operation)
+      : operation_(operation), enabled_(REXCVAR_GET(sdl_poll_timing_log)) {
+    if (enabled_) start_ = std::chrono::steady_clock::now();
+  }
+  ~PollTimer() {
+    if (!enabled_) return;
+    const double ms = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - start_).count();
+    if (ms > 5.0) REXLOG_INFO("[input_timing] {} {:.3f} ms", operation_, ms);
+  }
+ private:
+  const char* operation_;
+  bool enabled_;
+  std::chrono::steady_clock::time_point start_;
+};
+}  // namespace
 
