# Writes the title screen's build label (src/build_label.cpp) at every build:
#   cmake -DSOURCE_DIR=<repo> -DOUT=<header> -DVERSION=<x.y.z> -P BuildInfo.cmake
# The label is the version, the commit count as the build number, the short
# commit hash (+ when tracked files have changes) and the commit date. The
# header is rewritten only when the text changes, so an unchanged tree
# rebuilds nothing. Without git (a source copy) it is the version alone.
set(_git_ok FALSE)
find_program(_git git)
if(_git)
    execute_process(COMMAND "${_git}" rev-list --count HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _count OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _r1)
    execute_process(COMMAND "${_git}" rev-parse --short HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _r2)
    execute_process(COMMAND "${_git}" log -1 --format=%cs WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _r3)
    execute_process(COMMAND "${_git}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE _changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_r1 EQUAL 0 AND _r2 EQUAL 0 AND _r3 EQUAL 0 AND _count)
        set(_git_ok TRUE)
    endif()
endif()
if(_git_ok)
    set(_plus "")
    if(_changes)
        set(_plus "+")
    endif()
    set(_label "v${VERSION} build ${_count} (${_hash}${_plus}, ${_date})")
else()
    set(_label "v${VERSION}")
endif()
set(_text "// Generated by tools/BuildInfo.cmake at build time.\n#pragma once\ninline constexpr char kOutrunBuildLabel[] = \"${_label}\";\n")
set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUT}" "${_text}")
endif()
